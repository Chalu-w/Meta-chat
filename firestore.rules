rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isConversationParticipant(conversationId) {
      return isAuthenticated() && (
        request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantUids
      );
    }

    // 1. User Profiles Collection
    match /users/{userId} {
      // Any authenticated user can read public user profiles (for contact search / discovery)
      allow read: if isAuthenticated();

      // Only the authenticated account owner can create or update their own profile
      allow create, update: if isUser(userId);

      // Disallow deleting user documents
      allow delete: if false;
    }

    // 2. Conversations Collection
    match /conversations/{conversationId} {
      // A user can read a conversation ONLY if they are an authorized participant
      allow read: if isAuthenticated() && (request.auth.uid in resource.data.participantUids);

      // Authenticated users can create a new conversation if they include themselves in the participant list
      allow create: if isAuthenticated() && (request.auth.uid in request.resource.data.participantUids);

      // Participants can update metadata (e.g., lastMessage, updatedAt, unreadCount)
      allow update: if isAuthenticated() && (request.auth.uid in resource.data.participantUids);

      // Deletion allowed only by conversation creator
      allow delete: if isAuthenticated() && (resource.data.creatorId == request.auth.uid);

      // 3. Real-Time Messages Subcollection
      match /messages/{messageId} {
        // Authenticated users can ONLY read messages if they belong to this conversation
        allow read: if isConversationParticipant(conversationId);

        // Authenticated users can create messages if:
        // - They are authorized participants of the parent conversation
        // - The senderId field matches their verified Firebase Auth UID
        allow create: if isAuthenticated() &&
          request.resource.data.senderId == request.auth.uid &&
          isConversationParticipant(conversationId);

        // Participants can update message state (e.g. emoji reactions, delivery status)
        allow update: if isConversationParticipant(conversationId);

        // Only the original author can delete their own message
        allow delete: if isAuthenticated() && resource.data.senderId == request.auth.uid;
      }
    }
  }
}
