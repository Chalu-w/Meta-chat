# Meta Chat Backend Configuration

PORT=5000
NODE_ENV=development
JWT_SECRET=meta-chat-super-secure-production-jwt-key-2026

# Firebase Phone Authentication
FIREBASE_PROJECT_ID=meta-chat-5180c

# SMS Provider Integration (Twilio / Firebase)
# Provide your live Twilio credentials below to dispatch real SMS to Ethiopian (Ethio Telecom, Safaricom) and international numbers:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Optional: Twilio Verify Service SID (if using Twilio Verify API)
TWILIO_VERIFY_SERVICE_SID=


# Development Test Mode
# In production, set ALLOW_DEV_TEST_OTP=false and NODE_ENV=production.
# When enabled in development, allows testing with sandbox number: +251900000000 or master test code for designated test users.
ALLOW_DEV_TEST_OTP=true
DEV_SANDBOX_TEST_NUMBER=+251900000000
DEV_SANDBOX_OTP=849201
