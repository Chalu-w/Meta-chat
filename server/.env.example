# Meta Chat Production Environment Configuration

# Server Port & Secrets
PORT=5000
JWT_SECRET=meta-chat-super-secure-production-jwt-key-2026

# Twilio SMS Carrier Integration (For live SMS delivery to Ethiopia, UAE, Saudi, Qatar, Canada, Jordan, etc.)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Firebase Phone Auth Integration (Optional alternative for Firebase Auth Phone Sign-In)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Object Storage (For media, photos, and voice notes)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=
